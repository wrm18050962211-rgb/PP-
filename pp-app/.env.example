# Copy this file to .env.local for local development.
VITE_APP_ENV=development
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_ENABLE_MOCK=true
VITE_ENABLE_TEST_ROLE_SWITCH=true

# Production/App Store build checklist:
# VITE_APP_ENV=production
# VITE_API_BASE_URL=https://api.weareinframe.com
# VITE_ENABLE_MOCK=false
# VITE_ENABLE_TEST_ROLE_SWITCH=false
# VITE_RELEASE_PROFILE=store_lite
# VITE_PRIVACY_URL=https://www.weareinframe.com/privacy
# VITE_TERMS_URL=https://www.weareinframe.com/terms
# VITE_SUPPORT_URL=https://www.weareinframe.com/support
