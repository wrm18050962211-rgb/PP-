# Runtime
APP_ENV=development
PORT=8787
PUBLIC_API_ORIGIN=http://127.0.0.1:8787
# Tencent Cloud staging/production: https://api.weareinframe.com
# Production must set this to the exact app/admin web origins, separated by commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_TEST_ROLE_SWITCH=true

# Storage driver
# Local MVP: json
# Tencent Cloud PostgreSQL migration: postgres
STORE_DRIVER=json
STORE_PATH=server/data/store.json
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pp_platform

# Maps/location
# Local MVP can stay manual until the map provider is wired.
MAP_PROVIDER=manual
AMAP_WEB_KEY=
TENCENT_MAP_KEY=
APPLE_MAPS_TOKEN=

# Tencent COS media upload policy
COS_BUCKET=pp-mvp-local-1250000000
COS_REGION=ap-shanghai
COS_PUBLIC_BASE_URL=https://pp-mvp-local-1250000000.cos.ap-shanghai.myqcloud.com
# Use a dedicated CAM sub-user with only STS/COS media permissions.
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# WeChat Mini Program auth and payment placeholders
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_PAY_MODE=mock
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
